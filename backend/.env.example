# Server Configuration
PORT=5000

# MongoDB Connection
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/auction?retryWrites=true&w=majority

# JWT Secret Key (use a strong random string in production)
JWT_SECRET=your_jwt_secret_key_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Production Notes:
# - Use strong random strings for JWT_SECRET
# - Enable Redis password authentication (REDIS_PASSWORD) in production
# - Update FRONTEND_URL to your production domain
# - Use environment-specific MongoDB credentials
